{
  "name": "naviguide-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/utils/*.test.js src/i18n/*.test.js src/engine/*.test.js src/layers/*.test.js src/constants/*.test.js src/hooks/*.test.js src/map/*.test.js src/components/*.test.js",
    "server": "uvicorn server.main:app --host 127.0.0.1 --port 8010 --reload",
    "e2e": "playwright test",
    "e2e:store": "PW_WITH_API=1 playwright test e2e/lots",
    "redites": "node scripts/redites.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
