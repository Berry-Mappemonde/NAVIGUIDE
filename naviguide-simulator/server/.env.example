# Copier vers naviguide-simulator/.env ou server/.env sur le VPS.
# Jamais de clé réelle dans le dépôt.

# Token Factory (soumission hackathon — obligatoire en prod)
NEBIUS_API_KEY=
# NAVIGUIDE_TF_BASE=https://api.tokenfactory.nebius.com/v1
# NAVIGUIDE_TF_MODEL_NANO=nvidia/Nemotron-3_5-Lightning
# NAVIGUIDE_TF_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
# NAVIGUIDE_TF_MODEL_WRITE=nvidia/Nemotron-3.5-Super-VL
# NAVIGUIDE_TF_MODEL_JUDGE=nvidia/Nemotron-3-Ultra-550b-a55b
# NAVIGUIDE_LLM_PROVIDERS=tokenfactory,nim,openrouter,claude   (défaut : Token Factory, puis NIM, OpenRouter, Claude)
# PROD : NAVIGUIDE_LLM_PROVIDERS=tokenfactory,nim,openrouter,claude
# NAVIGUIDE_LLM_TIMEOUT_FALLBACK=1   (défaut : après un timeout Token Factory, la cascade continue vers NIM, OpenRouter, Claude ; 0 = l'arrêter, texte de règles étiqueté)
# DEV / TESTS sans Token Factory (NIM gratuit build.nvidia.com, clé NVIDIA_API_KEY, débit limité) :
#   NAVIGUIDE_LLM_PROVIDERS=nim
#   NAVIGUIDE_LLM_MODE=on-demand
#   NAVIGUIDE_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b   (défaut : openai/gpt-oss-20b)
#   NAVIGUIDE_NIM_MODEL_WRITE=… / _DEEP=… / _FAST=… / _NANO=… / _JUDGE=… (facultatif, par palier)
#   NAVIGUIDE_NIM_FAST_TIERS=NANO,FAST + NAVIGUIDE_NIM_FAST_MODEL=… (facultatif)
#   NAVIGUIDE_NIM_CONCURRENCY=2 (1..16), NAVIGUIDE_NIM_MAX_ATTEMPTS=3 (1..5)
#   NAVIGUIDE_NIM_DEADLINE_S=30 (défaut : 30 s, borné entre 1 et 300 s ; tentative complète, attente du sémaphore et réessais compris)
#   par worker uvicorn : avec plusieurs workers, mettre 1
# Les appels NIM ne sont jamais comptés en tokens ni en USD Token Factory (seulement le compteur de repli).
# Juges / prod : ne rien changer, Token Factory reste en tête.
#   (à constater sur /ici/warm/status : fallback.nim = 0). Sinon un 5xx TF peut basculer sur NIM gpt-oss-20b (étiqueté nvidia-…).
# NAVIGUIDE_TF_TIMEOUT_S=25          (échéance TOTALE par appel nano/fast/write ; un timeout est compté au budget, estimation prudente)
# NAVIGUIDE_TF_TIMEOUT_ULTRA_S=45    (idem pour deep/judge)
# NAVIGUIDE_LLM_DAILY_TOKENS_NANO=100000
# NAVIGUIDE_LLM_DAILY_TOKENS_FAST=2000000
# NAVIGUIDE_LLM_DAILY_TOKENS_WRITE=500000
# NAVIGUIDE_LLM_DAILY_TOKENS_JUDGE=100000

# Replis (optionnels)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# NIM — 2e maillon de la cascade (ne compte pas pour le hackathon, mais reste un repli)
NVIDIA_API_KEY=

# Tavily — extract PoE Gold ; veille deux tours si drapeau ouvert
TAVILY_API_KEY=
# TAVILY_API_BASE=https://api.tavily.com
# NAVIGUIDE_TAVILY_WATCH=1  # active par défaut
# NAVIGUIDE_PORT_WEB=1
# NAVIGUIDE_WATCH_DAILY_SEARCHES=6
