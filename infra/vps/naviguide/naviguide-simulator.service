[Unit]
Description=NAVIGUIDE simulator — searoute + polar without chat (simulator.naviguide.fr)
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/blue-intelligence-map/naviguide-simulator
EnvironmentFile=-/home/ubuntu/.config/naviguide/simulator.env
ExecStart=/home/ubuntu/blue-intelligence-map/naviguide-simulator/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30
# Pas de MemoryHigh. Au-dessus du plafond souple le noyau fige le process
# (D / mem_cgroup_handle_over_high) pendant la lecture de naviguide.sqlite
# (1,3 Go). 16 oct. 2026 : 2 Go de plafond, API muette, perles arrêtées.
# MemoryMax + Restart=always : trop gros → tué, puis relancé.
MemoryMax=4G

[Install]
WantedBy=multi-user.target
