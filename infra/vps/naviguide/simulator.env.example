# Optional simulator secrets — copy to
# ~/.config/naviguide/simulator.env (chmod 600).
# Do not paste LLM keys (NVIDIA / OpenRouter / Anthropic) here:
# the simulator has no chat and no orchestrator.
#
# Without Copernicus: wind / wave / current = internal fallback (enough
# for step 1). For live data, copy only these two lines
# from ~/.config/naviguide/naviguide.env — do not point EnvironmentFile
# at naviguide.env (that would load LLM keys into the process).

#COPERNICUS_USERNAME=
#COPERNICUS_PASSWORD=
