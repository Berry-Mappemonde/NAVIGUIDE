# Secrets for NAVIGUIDE services on the VPS — copy to
# ~/.config/naviguide/naviguide.env (chmod 600). Read by the systemd units
# naviguide-api / naviguide-orchestrator / naviguide-polar (EnvironmentFile).

# LLM cascade (expedition briefing, AI agents, polar chat):
# NVIDIA NIM → OpenRouter → Anthropic Claude. A provider without a key is skipped.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional models (defaults: deepseek-v4-pro / gpt-4o-mini / claude-opus-4-5)
#NVIDIA_MODEL=
#OPENROUTER_MODEL=
#ANTHROPIC_MODEL=

# Copernicus Marine — live wind / waves / currents (without credentials:
# climatology fallback)
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# StormGlass — live weather for the weather agent (optional)
STORMGLASS_API_KEY=
